{
  "name": "theop-io-static",
  "version": "1.0.0",
  "description": "Static assets for https://theop.io",
  "scripts": {
    "clean": "rimraf dist",
    "codegen": "npm-run-all --parallel codegen:*",
    "codegen:svg2css": "ts-node ./tools/svg-to-css.ts ./src/assets/packed ./src/generated/svg.scss",
    "codegen:reels": "ts-node ./tools/the-reels-build-tool.ts ./src/the-reels/generated/the-reels-db.ts",
    "codegen:shots": "ts-node ./tools/the-shots-build-tool.ts ./src/the-shots/generated/the-shots-db.ts",
    "codegen:words": "ts-node ./tools/the-words-build-tool.ts ./src/the-words/generated/the-words-db.ts",
    "build": "npm run codegen && webpack --config webpack.prod.ts",
    "serve": "npm run codegen && webpack serve --config webpack.dev.ts",
    "lint": "eslint .",
    "format:fix": "prettier --write ./*",
    "build-dev": "npm run codegen && webpack --config webpack.dev.ts",
    "dev:rewrite-imported-shots-data": "ts-node ./tools/rewrite-imported-shots-data.ts",
    "dev:migrate-shots-data": "ts-node ./tools/migrate-shots-data.ts",
    "dev:update-shots-filenames": "ts-node ./tools/update-shots-filenames.ts"
  },
  "author": "Robin Giese",
  "private": true,
  "devDependencies": {
    "@tsconfig/recommended": "^1.0.13",
    "@types/node": "^25.9.1",
    "@types/youtube": "^0.2.0",
    "@types/youtube-player": "^5.5.11",
    "@typescript-eslint/eslint-plugin": "^8.59.4",
    "@typescript-eslint/parser": "^8.59.4",
    "clean-webpack-plugin": "^4.0.0",
    "css-loader": "^7.1.4",
    "eslint": "^10.4.0",
    "html-bundler-webpack-plugin": "^4.23.0",
    "marked": "^18.0.4",
    "npm-run-all": "^4.1.5",
    "prettier": "^3.8.3",
    "rimraf": "^6.1.3",
    "sass": "^1.100.0",
    "sass-loader": "^17.0.0",
    "svgo": "^4.0.1",
    "ts-loader": "^9.5.7",
    "ts-node": "^10.9.2",
    "typescript": "^6.0.3",
    "webpack": "^5.107.1",
    "webpack-cli": "^7.0.2",
    "webpack-dev-server": "^5.2.4",
    "webpack-merge": "^6.0.1",
    "yup": "^1.7.1"
  },
  "dependencies": {
    "@fancyapps/ui": "^6.1.14",
    "@floating-ui/dom": "^1.7.6",
    "youtube-player": "^5.6.0"
  }
}
